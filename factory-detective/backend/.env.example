# =============================================================================
# FACTORY DETECTIVE — backend environment template
# Copy this file to `.env` and fill in values. The app runs FULLY without any
# keys — all AI features fall back to a deterministic local generator.
# =============================================================================

# --- Optional LLM (AI Decision Brief) ----------------------------------------
# If set, the brief endpoint will try the configured LLM and fall back to the
# local deterministic generator on any error. NEVER commit real keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Optional vision API (Inspect page) --------------------------------------
# The Inspect page ships with a clearly-labelled DEMO VISION MODE; this key is
# only used if you wire a real vision endpoint later.
VISION_API_KEY=

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Data --------------------------------------------------------------------
# Optional override for the dataset folder. Defaults to the bundled
# "Manufacturing Data Shared Facility" folder at the repo root.
# DATA_DIR=
