# ForgeSite backend environment template
# Copy to .env. The app runs fully without any keys.

# Optional LLM for FORGE AI phrasing (retrieval stays backend-side; the model
# only rewords evidence retrieved from the dataset — it never invents facts).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional data-location override (defaults to backend/data)
# FORGESITE_DATA=

# Optional external computer-vision endpoint for the Inspect page. ForgeSite
# ships NO vision model (the dataset has no images) and never fakes results.
# If set, POST {image_base64} is forwarded here and the verdict JSON relayed.
# FORGE_VISION_URL=
