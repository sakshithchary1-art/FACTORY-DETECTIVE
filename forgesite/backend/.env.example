# Forge SIGHT backend — copy to .env and adjust. Never commit real secrets.

# --- Dataset paths (configurable, no hardcoded locations) -------------------
# Path to the supplied image dataset (ZIP archive or extracted folder).
# Defaults to "<repo>/IMAGES DATASET" next to this project when unset.
IMAGE_DATASET_PATH=

# Root folder holding Model_1.csv / Model_2.csv / Model_3.csv / 3000Samplesv3.mat
# (defaults to backend/data when unset)
MANUFACTURING_DATASET_PATH=

# --- Optional vision model --------------------------------------------------
# A trained classifier produced by POST /api/vision/train is stored under
# backend/generated/vision_model.joblib unless a custom path is set here.
VISION_MODEL_PATH=

# Optional external computer-vision endpoint. If set, /api/vision forwards
# uploads there ({ "image_base64": "..." }) and relays the verdict JSON.
# If unset, the built-in pipeline (real/prototype over the dataset's actual
# classes) is used instead.
VISION_API_URL=
FORGE_VISION_URL=

# --- Optional LLM (AI Summary works without one) ----------------------------
LLM_API_KEY=
LLM_API_URL=
